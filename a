-- === CONSULTAS ======

-- 1. productos mas vendidos

-- 2. total de ingresos generados por cada combo

SELECT combos.id,combos.nombre ,SUM(combos.precio*detalle_pedido.cantidad) AS total_combos_vendidos
FROM combos 
JOIN detalle_pedido ON detalle_pedido.id_combo = combos.id 
GROUP BY detalle_pedido.id_combo


-- 3. pedidos realizados para recoger vs comer en la pizzeria (se visualizan ambos)

SELECT pedidos.id , detalle_pedido.id_producto ,detalle_pedido.id_combo, pedidos.consumo
FROM pedidos 
JOIN detalle_pedido ON detalle_pedido.id_pedido = pedidos.id

-- 4.adiciones mas solicitadas 

SELECT pedidos.id AS IDpedidos,  adicionales.nombre 
FROM pedidos 
JOIN detalle_pedido ON detalle_pedido.id = pedidos.id
JOIN adicionales ON adicionales.id = detalle_pedido.id_adicionales 

-- 5. Cantidad total de productos vendidos por categoria

SELECT detalle_pedido.id, detalle_pedido.id_producto, menu.nombre, categoria.nombre
FROM detalle_pedido 
JOIN menu ON menu.id = detalle_pedido.id_producto  	-- Solo muestra los de pedidos y no combos pq al ser combo tiene mas de una clasificacion y esta busqueda es con una categoiria especifica
JOIN categoria ON categoria.id = menu.categoria 

-- 6. promedio de pizzas pedidas por cliente

SELECT clientes.nombre, pedidos.id AS pizzas_pedidas
FROM clientes 
JOIN pedidos ON pedidos.id_cliente = clientes.id 


